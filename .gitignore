# Environment
.venv/
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/

# Credentials (never commit)
kaggle.json
.env

# Competition data: Kaggle rules do not allow redistributing it
train.csv
test.csv
sample_submission.parquet
logs/stub_test/grouped_data/

# External data (open pool, community datasets): large, re-downloadable from Kaggle
data/

# Other people's notebooks pulled with `kaggle kernels pull`
ext_kernels/

# Model weights and Kaggle dataset staging (hardlinks to models/); keep the metadata files
models/
upload/*/*
!upload/*/dataset-metadata.json

# Prediction arrays, cached features and submissions (large binaries, regenerated by the scripts)
*.npy
*.npz
*.parquet
*.safetensors
